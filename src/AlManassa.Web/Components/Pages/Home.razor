@page "/"
@rendermode InteractiveServer
@using AlManassa.Web
@inject CourseStore Store
<PageTitle>المنصة | Al-Manassa</PageTitle>
<header class="site-header">
  <a class="brand" href="/"><span class="brand-icon">▶</span><span>المنصة<small>Al-Manassa</small></span></a>
  <nav class="site-nav"><a href="#courses">الدورات</a><a href="#features">المميزات</a><a href="#about">عن المنصة</a></nav>
  <div class="header-actions"><button @onclick="ToggleLanguage">@(english ? "العربية" : "English")</button><a class="dash-link" href="/dashboard">لوحة الإدارة</a></div>
</header>
<main dir="@(english ? "ltr" : "rtl")">
  <section class="hero hero-new"><div class="hero-content"><span class="eyebrow">AL-MANASSA · LEARN WITHOUT LIMITS</span><h1>@(english ? "Your next skill starts here." : "مستقبلك يبدأ بمهارة جديدة")</h1><p>@(english ? "Explore flexible courses designed for the skills of tomorrow." : "اكتشف دورات ومسارات تعليمية تساعدك على تطوير مهاراتك وتحقيق أهدافك.")</p><a href="#courses">@(english ? "Explore courses" : "استكشف الدورات")</a></div><div class="hero-art"><div class="art-orbit">▶</div><span>Learn · Grow · Achieve</span></div></section>
  <section class="feature-strip" id="features"><div><strong>01</strong><span>تعلم بالسرعة المناسبة لك</span></div><div><strong>02</strong><span>مسارات تعليمية متنوعة</span></div><div><strong>03</strong><span>تجربة متوافقة مع جميع الأجهزة</span></div></section>
  <section class="course-section" id="courses"><div class="section-heading"><div><span class="eyebrow">EXPLORE COURSES</span><h2>@(english ? "Featured courses" : "اكتشف الدورات التعليمية")</h2></div><p>تعلم في أي وقت ومن أي مكان</p></div>
  @if (loading) { <div class="course-message">جاري تحميل الدورات من قاعدة البيانات...</div> }
  else if (error != null) { <div class="course-message">تعذر تحميل الدورات من قاعدة البيانات. تأكد من إعداد DATABASE_URL وتنفيذ ملف SQL. <button @onclick="Load">إعادة المحاولة</button></div> }
  else if (courses.Count == 0) { <div class="course-message">لا توجد دورات منشورة بعد.</div> }
  else { <div class="course-grid">@foreach(var course in courses) { <article class="course-card"><div class="course-cover"><span>@CategoryIcon(course.Category)</span><small>@course.Category</small></div><div class="course-body"><span class="course-meta">@course.DurationWeeks أسابيع · تعلم مرن</span><h3>@(english ? course.TitleEn : course.TitleAr)</h3><p>@course.Description</p><span class="course-footer">التفاصيل قريبًا ←</span></div></article> }</div> }
  </section>
  <section class="cta-section" id="about"><h2>رحلتك التعليمية تبدأ من هنا</h2><p>منصة تعليمية عربية برؤية عالمية وتجربة رقمية متكاملة.</p><a href="#courses">تصفح الدورات</a></section>
</main>
<footer>© 2026 المنصة | Al-Manassa</footer>
@code {
 bool english;
 bool loading=true;
 string? error;
 List<CourseItem> courses=new();
 protected override async Task OnInitializedAsync() => await Load();
 async Task Load() {loading=true;error=null;try {courses=await Store.PublishedAsync();}catch(Exception){error="Database unavailable";}finally{loading=false;}}
 void ToggleLanguage()=>english=!english;
 string CategoryIcon(string c)=>c.ToLowerInvariant() switch {"technology"=>"✦","programming"=>"⌘","business"=>"◈",_=>"◆"};
}
