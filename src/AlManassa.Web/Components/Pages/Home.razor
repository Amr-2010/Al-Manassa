@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components
@page "/"
@rendermode InteractiveServer
@using AlManassa.Web
@inject CourseStore Store
@inject LearningStore Learning
<PageTitle>المنصة | Al-Manassa</PageTitle>
<header class="site-header">
  <a class="brand" href="/"><img class="official-brand-logo" src="/almanassa-official-logo.webp" alt="المنصة Al-Manassa" onerror="this.style.display='none';this.nextElementSibling.style.display='inline-block'" /><span class="brand-fallback" style="display:none">المنصة<small>Al-Manassa</small></span></a>
  <nav class="site-nav"><a href="#subjects">التخصصات</a><a href="#courses">الدورات</a><a href="#about">عن المنصة</a></nav>
  <div class="header-actions"><button @onclick="ToggleLanguage">@(english ? "العربية" : "English")</button><AuthorizeView Context="auth"><Authorized><span class="signed-in-name">مرحبًا، @(auth.User.Identity?.Name ?? auth.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "مستخدم المنصة")</span><a class="dash-link" href="@(auth.User.IsInRole("Admin") ? "/dashboard" : "/#courses")">@(auth.User.IsInRole("Admin") ? "لوحة الإدارة" : "دوراتي")</a><form method="post" action="/logout"><AntiforgeryToken /><button type="submit">خروج</button></form></Authorized><NotAuthorized><a class="dash-link" href="/login">تسجيل الدخول</a><a class="dash-link" href="/register">تسجيل متدرب جديد</a></NotAuthorized></AuthorizeView></div>
</header>
<main dir="@(english ? "ltr" : "rtl")">
  <section class="hero hero-new"><div class="hero-content"><span class="hero-kicker">منصة تعليمية متكاملة · تعلم بمرونة</span><h1>@(english ? "Your next skill starts here." : "مستقبلك يبدأ بمهارة جديدة")</h1><p>@(english ? "Explore flexible courses designed for the skills of tomorrow." : "اكتشف دورات ومسارات تعليمية تساعدك على تطوير مهاراتك وتحقيق أهدافك.")</p><div class="hero-actions"><a href="#courses">@(english ? "Explore courses" : "استكشف الكورسات")</a><a class="hero-secondary-action" href="/register">ابدأ مجانًا</a></div><form class="hero-search" method="get" action="/"><label for="hero-course-search">ابحث عن الكورس المناسب لك</label><div><input id="hero-course-search" type="search" name="q" placeholder="اسم الكورس أو التخصص..." /><button type="submit">بحث</button></div></form></div><div class="hero-art"><img class="hero-official-logo" src="/almanassa-official-logo.webp" alt="المنصة Al-Manassa" /><span>Learn · Grow · Achieve</span></div></section>
  <section class="home-live-summary" aria-label="محتوى المنصة"><div><strong>@Subjects.Count</strong><span>قسم تعليمي متاح</span></div><div><strong>@courses.Count</strong><span>كورس منشور</span></div><div><strong>@(Subjects.Count==0?0:Subjects.Count(x=>courses.Any(c=>c.Category==x.Key)))</strong><span>قسم به كورسات منشورة</span></div></section>
  <section class="feature-strip" id="features"><div><strong>▶</strong><span>فيديوهات تعليمية</span></div><div><strong>✓</strong><span>اختبارات وتقييمات</span></div><div><strong>▥</strong><span>متابعة التقدم</span></div><div><strong>★</strong><span>شهادات إتمام</span></div></section>
  <section class="catalog-section" id="subjects">
<div class="section-heading"><div><h2>استكشف التخصصات التعليمية</h2></div><p>اختر المجال الذي يناسب أهدافك المهنية</p></div>
<div class="subject-grid">
@if(Subjects.Count==0){<p class="course-message">لا توجد أقسام تعليمية مفعّلة حاليًا.</p>}
@foreach(var subject in Subjects){<a class="subject-tile" href="@(courses.Count(c=>c.Category==subject.Key)==1 ? $"/learn/{courses.First(c=>c.Category==subject.Key).Id}" : $"/?category={Uri.EscapeDataString(subject.Key)}#courses")"><span class="subject-icon">@subject.Icon</span><strong>@subject.Name</strong><small>@courses.Count(c=>c.Category==subject.Key) كورس منشور</small></a>}
</div></section>
<section class="course-ticker-section" aria-label="شريط الكورسات المتاحة">
  <div class="course-ticker-heading"><strong>الكورسات المتاحة</strong><span>اضغط على أي كورس لفتح صفحته مباشرة</span></div>
  @if(courses.Count>0){
    <div class="course-ticker-viewport" dir="rtl">
      <div class="course-ticker-track">
        <div class="course-ticker-copy">
          @foreach(var course in courses){<a class="course-ticker-link" href="@($"/learn/{course.Id}")"><span class="ticker-dot">✦</span>@course.TitleAr</a>}
          @for(var repeat=0;repeat<9;repeat++){
            @foreach(var course in courses){<a class="course-ticker-link" href="@($"/learn/{course.Id}")" tabindex="-1" aria-hidden="true"><span class="ticker-dot">✦</span>@course.TitleAr</a>}
          }
        </div>
        <div class="course-ticker-copy" aria-hidden="true">
          @for(var repeat=0;repeat<10;repeat++){
            @foreach(var course in courses){<a class="course-ticker-link" href="@($"/learn/{course.Id}")" tabindex="-1"><span class="ticker-dot">✦</span>@course.TitleAr</a>}
          }
        </div>
      </div>
    </div>
  }else{<p class="course-message">لا توجد كورسات منشورة حاليًا.</p>}
</section>
<section class="course-section" id="courses"><div class="section-heading"><div><h2>الكورسات الأكثر دراسة والكورسات الجديدة</h2></div><p>تعلم في أي وقت ومن أي مكان</p></div>
  <div class="catalog-toolbar"><label>ابحث عن دورة <input type="search" @bind="search" @bind:event="oninput" placeholder="اسم الدورة أو المجال..." /></label><a class="catalog-reset-link" href="/#courses">جميع التخصصات</a>@if(!string.IsNullOrEmpty(categoryFilter)){<span>التخصص: @categoryFilter</span>}</div>
  @if (loading) { <div class="course-message">جاري تحميل الدورات من قاعدة البيانات...</div> }
  else if (error != null) { <div class="course-message">تعذر تحميل الدورات من قاعدة البيانات. تأكد من إعداد DATABASE_URL وتنفيذ ملف SQL. <button @onclick="Load">إعادة المحاولة</button></div> }
  else if (FilteredCourses.Count == 0) { <div class="course-message">@(string.IsNullOrWhiteSpace(categoryFilter) && string.IsNullOrWhiteSpace(search)?"لا توجد كورسات منشورة بعد.":"لا توجد كورسات منشورة مطابقة للبحث أو القسم المحدد.")</div> }
  else {
    <div class="course-collection"><div class="course-collection-heading"><h3>الأكثر دراسة</h3><span>مرتبة حسب عدد المتدربين الملتحقين فعليًا</span></div>
      <div class="course-grid">
        @foreach(var course in FilteredCourses.OrderByDescending(c=>enrollmentCounts.GetValueOrDefault(c.Id)).ThenBy(c=>courses.IndexOf(c)).Take(6)){
          <article class="course-card"><div class="course-cover"><span>@CategoryIcon(course.Category)</span><small>@(Subjects.FirstOrDefault(x=>x.Key==course.Category)?.Name ?? course.Category)</small></div><div class="course-body"><span class="course-meta">@course.DurationWeeks أسابيع · تعلم مرن</span><h3>@(english ? course.TitleEn : course.TitleAr)</h3><p>@course.Description</p><div class="course-lessons-preview"><strong>الدروس المتاحة (@(courseLessonTitles.GetValueOrDefault(course.Id)?.Count ?? 0))</strong>@if(courseLessonTitles.TryGetValue(course.Id,out var titles) && titles.Count>0){<ol>@foreach(var title in titles.Take(4)){<li>@title</li>}</ol>@if(titles.Count>4){<small>و @(titles.Count-4) دروس أخرى</small>}}else{<small>لم تُضف دروس بعد</small>}</div><a class="course-footer" href="@($"/learn/{course.Id}")">ابدأ التعلم ←</a></div></article>
        }
      </div>
    </div>
    <div class="course-collection"><div class="course-collection-heading"><h3>الكورسات الجديدة</h3><span>أحدث الكورسات المنشورة على المنصة</span></div>
      <div class="course-grid">
        @foreach(var course in FilteredCourses.OrderBy(c=>courses.IndexOf(c)).Take(6)){
          <article class="course-card"><div class="course-cover"><span>@CategoryIcon(course.Category)</span><small>@(Subjects.FirstOrDefault(x=>x.Key==course.Category)?.Name ?? course.Category)</small></div><div class="course-body"><span class="course-meta">@course.DurationWeeks أسابيع · تعلم مرن</span><h3>@(english ? course.TitleEn : course.TitleAr)</h3><p>@course.Description</p><div class="course-lessons-preview"><strong>الدروس المتاحة (@(courseLessonTitles.GetValueOrDefault(course.Id)?.Count ?? 0))</strong>@if(courseLessonTitles.TryGetValue(course.Id,out var titles) && titles.Count>0){<ol>@foreach(var title in titles.Take(4)){<li>@title</li>}</ol>@if(titles.Count>4){<small>و @(titles.Count-4) دروس أخرى</small>}}else{<small>لم تُضف دروس بعد</small>}</div><a class="course-footer" href="@($"/learn/{course.Id}")">ابدأ التعلم ←</a></div></article>
        }
      </div>
    </div>
  }
  </section>
  <section class="join-banner"><div><span class="eyebrow">PERSONAL LEARNING</span><h2>تعلم على طريقتك</h2><p>أنشئ حسابك لمتابعة الدورات المتاحة. سيتم إضافة التوصيات الشخصية وسجل التقدم مع استكمال نظام التعلم.</p></div><AuthorizeView><Authorized><a href="#courses">استكمل التعلم</a></Authorized><NotAuthorized><a href="/register">تسجيل متدرب جديد</a></NotAuthorized></AuthorizeView></section>
  <section class="cta-section" id="about"><h2>رحلتك التعليمية تبدأ من هنا</h2><p>منصة تعليمية عربية برؤية عالمية وتجربة رقمية متكاملة.</p><a href="#courses">تصفح الدورات</a></section>
</main>
<footer>© 2026 المنصة | Al-Manassa</footer>
@code {
 [SupplyParameterFromQuery(Name="category")] public string? Category {get;set;}
 [SupplyParameterFromQuery(Name="q")] public string? Query {get;set;}
 string search=""; string categoryFilter="";
 List<SubjectItem> Subjects=new();
 List<CourseItem> FilteredCourses => courses.Where(x =>
 (string.IsNullOrWhiteSpace(categoryFilter) || x.Category.Equals(categoryFilter,StringComparison.OrdinalIgnoreCase)) &&
 (string.IsNullOrWhiteSpace(search) || x.TitleAr.Contains(search,StringComparison.OrdinalIgnoreCase) || x.TitleEn.Contains(search,StringComparison.OrdinalIgnoreCase) || x.Category.Contains(search,StringComparison.OrdinalIgnoreCase))
 ).ToList();
 void SelectSubject(string key){categoryFilter=key;search="";}
 void ClearFilters(){categoryFilter="";search="";}
 bool english;
 bool loading=true;
 string? error;
 List<CourseItem> courses=new();
 Dictionary<Guid,List<string>> courseLessonTitles=new();
 Dictionary<Guid,long> enrollmentCounts=new();
 protected override async Task OnInitializedAsync() {categoryFilter=Category??"";search=Query??"";await Load();}
 async Task Load() {loading=true;error=null;try {courses=await Store.PublishedAsync();Subjects=await Store.SubjectsAsync();enrollmentCounts=await Store.PublishedEnrollmentCountsAsync();foreach(var course in courses){try{courseLessonTitles[course.Id]=(await Learning.PublicLessonTitlesAsync(course.Id)).Select(x=>x.Title).ToList();}catch(Exception){courseLessonTitles[course.Id]=new();}}}catch(Exception){error="Database unavailable";}finally{loading=false;}}
 void ToggleLanguage()=>english=!english;
 string CategoryIcon(string c)=>c.ToLowerInvariant() switch {"technology"=>"✦","programming"=>"⌘","business"=>"◈",_=>"◆"};
}
