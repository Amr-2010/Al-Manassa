@page "/dashboard/content"
@attribute [Authorize(Roles="Admin")]
@using Microsoft.AspNetCore.Authorization
@using AlManassa.Web
@inject ContentEditor Editor
@inject CourseStore Store
<PageTitle>إدارة الكورسات والدروس | المنصة</PageTitle>
<main dir="rtl" class="content-admin">
 <a href="/dashboard">← لوحة الإدارة</a>
 <h1>إدارة الكورسات والمناهج</h1>
 <nav class="content-admin-nav"><a href="/dashboard/subjects">1. الأقسام</a><a href="#courses">2. الكورسات</a><a href="#course-content">3. المراحل والدروس</a><a href="#ai-generator">4. الذكاء الاصطناعي</a></nav>
 @if(!string.IsNullOrEmpty(Notice)){<p class="category-notice" role="status">@Notice</p>}
 <section id="courses" class="panel content-admin-panel">
  <h2>2. @(editing is null?"إضافة كورس جديد":"تعديل بيانات الكورس: "+editing.TitleAr)</h2>
  <p>حدد القسم، ثم أدخل اسم الكورس ووصفه. لن يتم إنشاء دروس تلقائيًا.</p>
  <form method="post" action="/api/admin/courses/save">
   <AntiforgeryToken />
   @if(editing is not null){<input type="hidden" name="id" value="@editing.Id" />}
   <div class="category-form">
    <label>العنوان بالعربية<input name="ar" value="@(editing?.TitleAr??"")" maxlength="250" required /></label>
    <label>العنوان بالإنجليزية<input name="en" value="@(editing?.TitleEn??"")" maxlength="250" required /></label>
    <label>القسم التعليمي<select name="category" required><option value="">اختر القسم</option>@foreach(var subject in subjects.Where(x=>x.Active)){<option value="@subject.Key" selected="@(editing?.Category==subject.Key)">@subject.Name</option>}</select></label>
    <label>المدة بالأسابيع<input name="weeks" type="number" min="1" max="52" value="@(editing?.DurationWeeks??4)" required /></label>
   </div>
   <label>وصف الكورس<textarea name="description" maxlength="10000" rows="4">@(editing?.Description??"")</textarea></label>
   <label><input type="checkbox" name="published" value="true" checked="@(editing?.Published??false)" /> منشور للطلاب</label>
   <div><button type="submit">@(editing is null?"إضافة الكورس":"حفظ التعديلات")</button>
   @if(editing is not null){<a class="outline" href="/dashboard/content#courses">إلغاء التعديل</a>}</div>
  </form>
  <h3>الكورسات المسجلة (@courses.Count)</h3>
  <div class="content-table-scroll"><table class="content-courses-table"><thead><tr><th>الكورس</th><th>القسم</th><th>الحالة</th><th>الإجراءات</th></tr></thead><tbody>
  @foreach(var c in courses){<tr><td>@c.TitleAr</td><td>@subjects.FirstOrDefault(x=>x.Key==c.Category)?.Name</td><td>@(c.Published?"منشور":"مسودة")</td><td><a href="@("/dashboard/content?edit="+c.Id+"#courses")">تعديل</a> | <a href="@("/dashboard/content?course="+c.Id+"#course-content")">المراحل والدروس</a> | <a href="@("/dashboard/content?delete="+c.Id+"#delete-course")">حذف</a></td></tr>}
  </tbody></table></div>
  @if(deleting is not null){<div class="category-notice" id="delete-course"><h3>تأكيد حذف: @deleting.TitleAr</h3><p>لا يمكن حذف كورس له مراحل أو تسجيلات طلاب حفاظًا على بياناتهم.</p><form method="post" action="/api/admin/courses/delete"><AntiforgeryToken /><input type="hidden" name="id" value="@deleting.Id" /><button type="submit">تأكيد حذف الكورس الفارغ</button> <a href="/dashboard/content#courses">إلغاء</a></form></div>}
 </section>
 <section id="course-content" class="panel content-admin-panel">
  <h2>3. المراحل والدروس</h2>
  <p>اختر كورسًا من الجدول بالأعلى. كل مرحلة تحتوي على عدد غير محدود من الدروس، ويكتب الناشر المحتوى بنفسه.</p>
  @if(selected is null){<p class="category-notice">لم يتم تحديد كورس بعد. اضغط «المراحل والدروس» أمام الكورس المطلوب.</p>}
  else {
   <h3>الكورس المحدد: @selected.TitleAr</h3>
   <form method="post" action="/api/admin/stages/add"><AntiforgeryToken /><input type="hidden" name="course" value="@selected.Id" /><label>عنوان المرحلة الجديدة<input name="title" maxlength="250" required /></label><button type="submit">إضافة مرحلة</button></form>
   @foreach(var st in stages.Where(x=>x.CourseId==selected.Id)){
    <details open style="margin:12px 0;padding:14px;border:1px solid #ccd6e5;border-radius:10px">
     <summary><strong>المرحلة @st.Position: @st.Title</strong></summary>
     <form method="post" action="/api/admin/stages/rename"><AntiforgeryToken /><input type="hidden" name="id" value="@st.Id" /><input type="hidden" name="course" value="@selected.Id" /><label>اسم المرحلة<input name="title" value="@st.Title" maxlength="250" required /></label><button type="submit">حفظ اسم المرحلة</button></form>
     <h4>إضافة درس للمرحلة</h4>
     <form method="post" action="/api/admin/lessons/add"><AntiforgeryToken /><input type="hidden" name="stage" value="@st.Id" /><input type="hidden" name="course" value="@selected.Id" /><label>عنوان الدرس<input name="title" maxlength="250" required /></label><label>المنهج المكتوب<textarea name="content" maxlength="30000" rows="5" required></textarea></label><button type="submit">إضافة الدرس</button></form>
     @foreach(var l in lessons.Where(x=>x.Stage==st.Title && x.Course==selected.TitleAr)){
      <details style="padding:12px;margin:10px 0;border:1px solid #d6dbe5;border-radius:8px"><summary>@l.Title</summary>
       <form method="post" action="/api/admin/lessons/save"><AntiforgeryToken /><input type="hidden" name="id" value="@l.Id" /><input type="hidden" name="course" value="@selected.Id" /><label>عنوان الدرس<input name="title" value="@l.Title" required /></label><label>محتوى الدرس<textarea name="content" rows="6" required>@l.Content</textarea></label><label>رابط YouTube<input name="youtube" type="url" value="@(l.VideoProvider=="youtube"?"https://www.youtube.com/watch?v="+l.VideoReference:"")" placeholder="https://www.youtube.com/watch?v=..." /></label><button type="submit">حفظ الدرس والفيديو</button></form>
       <form method="post" action="/api/admin/lessons/delete"><AntiforgeryToken /><input type="hidden" name="id" value="@l.Id" /><input type="hidden" name="course" value="@selected.Id" /><button type="submit">حذف الدرس إذا لم يدرسه أي طالب</button></form>
      </details>
     }
    </details>
   }
  }
 </section>
 <section id="ai-generator" class="panel content-admin-panel">
  <h2>4. إنشاء مسودة منهج بالذكاء الاصطناعي</h2>
  <p>يُنشئ النظام مقترحًا للمراجعة في PostgreSQL، ولا ينشره تلقائيًا. يلزم إعداد OPENAI_API_KEY على الخادم.</p>
  <form method="post" action="/api/admin/curriculum/generate"><AntiforgeryToken /><div class="category-form">
   <label>موضوع الكورس<input name="topic" maxlength="250" placeholder="مثال: برمجة .NET" required /></label>
   <label>المستوى<select name="level"><option value="Beginner">مبتدئ</option><option value="Intermediate">متوسط</option><option value="Advanced">متقدم</option></select></label>
   <label>اللغة<select name="language"><option value="Arabic">العربية</option><option value="English">English</option></select></label>
   <label>عدد الأسابيع<input name="weeks" type="number" min="1" max="24" value="8" required /></label>
  </div><button type="submit">إنشاء مقترح المنهج</button></form>
 </section>
</main>
@code {
 [SupplyParameterFromQuery(Name="edit")]public Guid? EditId{get;set;}
 [SupplyParameterFromQuery(Name="course")]public Guid? CourseId{get;set;}
 [SupplyParameterFromQuery(Name="delete")]public Guid? DeleteId{get;set;}
 [SupplyParameterFromQuery(Name="notice")]public string? Notice{get;set;}
 List<ContentEditor.AdminCourse> courses=new();
 List<SubjectItem> subjects=new();
 List<(Guid Id,Guid CourseId,string Title,int Position)> stages=new();
 List<AdminLesson> lessons=new();
 ContentEditor.AdminCourse? editing,selected,deleting;
 protected override async Task OnParametersSetAsync(){
  try{courses=await Editor.CoursesAsync();subjects=await Store.AllSubjectsAsync();stages=await Editor.StagesAsync();lessons=await Editor.LessonsAsync();editing=courses.FirstOrDefault(x=>x.Id==EditId);selected=courses.FirstOrDefault(x=>x.Id==CourseId);deleting=courses.FirstOrDefault(x=>x.Id==DeleteId);}
  catch(Exception){Notice="تعذر تحميل البيانات من PostgreSQL";}
 }
}
