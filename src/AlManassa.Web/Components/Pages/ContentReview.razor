@page "/dashboard/content"
@attribute [Authorize(Roles="Admin")]
@using Microsoft.AspNetCore.Authorization
@using AlManassa.Web
@inject ContentEditor Editor
@inject CourseStore Store
<PageTitle>إدارة الكورسات والدروس | المنصة</PageTitle>
<main dir="rtl" class="content-admin">
 <a href="/dashboard">← لوحة الإدارة</a>
 <h1>إدارة الكورسات والمناهج</h1>
 @if(!string.IsNullOrEmpty(Notice)){<p class="category-notice" role="status">@Notice</p>}
 <section id="courses" class="panel content-admin-panel">
  <h2>2. @(editing is null?"إضافة كورس جديد":"تعديل بيانات الكورس: "+editing.TitleAr)</h2>
  <p>حدد القسم، ثم أدخل اسم الكورس ووصفه. لن يتم إنشاء دروس تلقائيًا.</p>
  <form class="course-editor-form" method="post" action="/api/admin/courses/save">
   <AntiforgeryToken />
   @if(editing is not null){<input type="hidden" name="id" value="@editing.Id" />}
   <div class="course-editor-grid">
    <label>العنوان بالعربية<input name="ar" value="@(editing?.TitleAr??"")" maxlength="250" required /></label>
    <label>العنوان بالإنجليزية<input name="en" value="@(editing?.TitleEn??"")" maxlength="250" required /></label>
    <label>القسم التعليمي<select name="category" required><option value="">اختر القسم</option>@foreach(var subject in subjects.Where(x=>x.Active)){<option value="@subject.Key" selected="@(editing?.Category==subject.Key)">@subject.Name</option>}</select></label>
    <label>المدة بالأسابيع<input name="weeks" type="number" min="1" max="52" value="@(editing?.DurationWeeks??4)" required /></label>
   </div>
   <label class="course-description-field">وصف الكورس<textarea name="description" maxlength="10000" rows="5" placeholder="اكتب وصفًا واضحًا لمحتوى الكورس وأهدافه التعليمية">@(editing?.Description??"")</textarea></label>
   <div class="course-editor-footer"><label class="course-publish-toggle"><input type="checkbox" name="published" value="true" checked="@(editing?.Published??false)" /> منشور للطلاب</label>
   <div class="course-editor-actions"><button type="submit">@(editing is null?"إضافة الكورس":"حفظ التعديلات")</button>
   @if(editing is not null){<a class="outline" href="/dashboard/content#courses">إلغاء التعديل</a>}</div></div>
  </form>
  <h3>الكورسات المسجلة (@courses.Count)</h3>
  <div class="content-table-scroll"><table class="content-courses-table"><thead><tr><th>الكورس</th><th>القسم</th><th>الحالة</th><th>الإجراءات</th></tr></thead><tbody>
  @foreach(var c in courses){<tr><td>@c.TitleAr</td><td>@subjects.FirstOrDefault(x=>x.Key==c.Category)?.Name</td><td>@(c.Published?"منشور":"مسودة")</td><td><a href="@("/dashboard/content?edit="+c.Id+"#courses")">تعديل</a> | <a href="@("/dashboard/content?course="+c.Id+"#course-content")">الدروس</a> | <a href="@("/dashboard/content?delete="+c.Id+"#delete-course")">حذف</a></td></tr>}
  </tbody></table></div>
  @if(deleting is not null){<div class="category-notice" id="delete-course"><h3>تأكيد حذف: @deleting.TitleAr</h3><p>لا يمكن حذف كورس يحتوي على دروس أو تسجيلات طلاب حفاظًا على بياناتهم.</p><form method="post" action="/api/admin/courses/delete"><AntiforgeryToken /><input type="hidden" name="id" value="@deleting.Id" /><button type="submit">تأكيد حذف الكورس الفارغ</button> <a href="/dashboard/content#courses">إلغاء</a></form></div>}
 </section>
 <section id="course-content" class="panel content-admin-panel">
  <h2>3. الدروس</h2>
  <p>اختر الكورس من الجدول بالأعلى، ثم أضف الدروس مباشرة بالترتيب. عدد الدروس غير محدود.</p>
  @if(selected is null){<p class="category-notice">لم يتم تحديد كورس بعد. اضغط «الدروس» أمام الكورس المطلوب.</p>}
  else {
   <h3>دروس الكورس: @selected.TitleAr</h3>
   <h4>إضافة درس جديد</h4>

     <form method="post" action="/api/admin/lessons/add"><AntiforgeryToken /><input type="hidden" name="course" value="@selected.Id" /><label>عنوان الدرس<input name="title" maxlength="250" required /></label><div class="lesson-rich-editor" data-lesson-editor>
       <div class="lesson-editor-toolbar" role="toolbar" aria-label="تنسيق المنهج">
        <button type="button" data-format="bold" title="عريض"><strong>B</strong></button>
        <button type="button" data-format="italic" title="مائل"><em>I</em></button>
        <button type="button" data-format="underline" title="تسطير"><u>U</u></button>
        <button type="button" data-format="insertUnorderedList" title="قائمة نقطية">☷</button>
        <button type="button" data-format="insertOrderedList" title="قائمة مرقمة">≡</button>
        <button type="button" data-format="formatBlock" data-value="h3" title="عنوان">H3</button>
        <button type="button" data-format="formatBlock" data-value="p" title="فقرة">¶</button>
        <button type="button" data-format="undo" title="تراجع">↶</button>
        <button type="button" data-format="redo" title="إعادة">↷</button>
       </div>
       <div class="lesson-editable" contenteditable="true" role="textbox" aria-multiline="true" aria-label="محتوى المنهج" data-placeholder="اكتب المنهج هنا ونسقه باستخدام الأدوات..."></div>
       <textarea name="content" hidden></textarea>
      </div><button type="submit">إضافة الدرس</button></form>
     @foreach(var l in lessons.Where(x=>x.Course==selected.TitleAr)){
      <details style="padding:12px;margin:10px 0;border:1px solid #d6dbe5;border-radius:8px"><summary>@l.Title</summary>
       <form method="post" action="/api/admin/lessons/save"><AntiforgeryToken /><input type="hidden" name="id" value="@l.Id" /><input type="hidden" name="course" value="@selected.Id" /><label>عنوان الدرس<input name="title" value="@l.Title" required /></label><div class="lesson-rich-editor" data-lesson-editor>
       <div class="lesson-editor-toolbar" role="toolbar" aria-label="تنسيق المنهج">
        <button type="button" data-format="bold" title="عريض"><strong>B</strong></button>
        <button type="button" data-format="italic" title="مائل"><em>I</em></button>
        <button type="button" data-format="underline" title="تسطير"><u>U</u></button>
        <button type="button" data-format="insertUnorderedList" title="قائمة نقطية">☷</button>
        <button type="button" data-format="insertOrderedList" title="قائمة مرقمة">≡</button>
        <button type="button" data-format="formatBlock" data-value="h3" title="عنوان">H3</button>
        <button type="button" data-format="formatBlock" data-value="p" title="فقرة">¶</button>
        <button type="button" data-format="undo" title="تراجع">↶</button>
        <button type="button" data-format="redo" title="إعادة">↷</button>
       </div>
       <div class="lesson-editable" contenteditable="true" role="textbox" aria-multiline="true" aria-label="محتوى المنهج" data-placeholder="اكتب المنهج هنا ونسقه باستخدام الأدوات...">@((MarkupString)ContentEditor.CleanLessonHtml(l.Content))</div>
       <textarea name="content" hidden>@l.Content</textarea>
      </div><label>رابط YouTube<input name="youtube" type="url" value="@(l.VideoProvider=="youtube"?"https://www.youtube.com/watch?v="+l.VideoReference:"")" placeholder="https://www.youtube.com/watch?v=..." /></label><button type="submit">حفظ الدرس والفيديو</button></form>
       <form method="post" action="/api/admin/lessons/upload-video" enctype="multipart/form-data">
        <AntiforgeryToken /><input type="hidden" name="id" value="@l.Id" /><input type="hidden" name="course" value="@selected.Id" />
        <label>رفع فيديو من الجهاز (MP4 أو WebM حتى 50 ميجابايت)<input type="file" name="video" accept="video/mp4,video/webm" required /></label>
        <button type="submit">رفع الفيديو وحفظه</button>
       </form>
       @if(l.VideoProvider=="hosted"){<video controls preload="metadata" style="width:100%;max-width:720px" src="@("/api/lessons/"+l.Id+"/video")"></video>}
       else if(l.VideoProvider=="youtube"){<p>فيديو YouTube مرتبط بالدرس: <a target="_blank" rel="noopener noreferrer" href="@("https://www.youtube.com/watch?v="+l.VideoReference)">فتح الفيديو</a></p>}
       <form method="post" action="/api/admin/lessons/delete"><AntiforgeryToken /><input type="hidden" name="id" value="@l.Id" /><input type="hidden" name="course" value="@selected.Id" /><button type="submit">حذف الدرس إذا لم يدرسه أي طالب</button></form>
      </details>
     }
  }
 </section>
 <section id="ai-generator" class="panel content-admin-panel">
  <h2>4. إنشاء مسودة منهج بالذكاء الاصطناعي</h2>
  <p>يُنشئ النظام مقترحًا للمراجعة في PostgreSQL، ولا ينشره تلقائيًا. يلزم إعداد GEMINI_API_KEY على الخادم.</p>
  <form method="post" action="/api/admin/curriculum/generate"><AntiforgeryToken /><div class="category-form">
   <label>موضوع الكورس<input name="topic" maxlength="250" placeholder="مثال: برمجة .NET" required /></label>
   <label>المستوى<select name="level"><option value="Beginner">مبتدئ</option><option value="Intermediate">متوسط</option><option value="Advanced">متقدم</option></select></label>
   <label>اللغة<select name="language"><option value="Arabic">العربية</option><option value="English">English</option></select></label>
   <label>عدد الأسابيع<input name="weeks" type="number" min="1" max="24" value="8" required /></label>
  </div><button type="submit">إنشاء مقترح المنهج</button></form>
  <h3>المناهج المُنشأة للمراجعة</h3>
  @if(suggestions.Count==0){<p>لا توجد مسودات محفوظة حتى الآن.</p>}
  @foreach(var draft in suggestions){
   <details class="panel" style="margin:12px 0;padding:14px">
    <summary><strong>@draft.Topic</strong> — @draft.Status</summary>
    <p>رقم المسودة: @draft.Id</p>
    <pre style="white-space:pre-wrap;overflow-wrap:anywhere;max-height:480px;overflow:auto;direction:ltr;text-align:left">@draft.Json</pre>
   </details>
  }
 </section>
</main>
@code {
 [SupplyParameterFromQuery(Name="edit")]public Guid? EditId{get;set;}
 [SupplyParameterFromQuery(Name="course")]public Guid? CourseId{get;set;}
 [SupplyParameterFromQuery(Name="delete")]public Guid? DeleteId{get;set;}
 [SupplyParameterFromQuery(Name="notice")]public string? Notice{get;set;}
 List<ContentEditor.AdminCourse> courses=new();
 List<SubjectItem> subjects=new();
 List<(Guid Id,string Topic,string Status,string Json)> suggestions=new();
 List<(Guid Id,Guid CourseId,string Title,int Position)> stages=new();
 List<AdminLesson> lessons=new();
 ContentEditor.AdminCourse? editing,selected,deleting;
 protected override async Task OnParametersSetAsync(){
  try{courses=await Editor.CoursesAsync();subjects=await Store.AllSubjectsAsync();suggestions=await Store.LatestSuggestionsAsync();stages=await Editor.StagesAsync();lessons=await Editor.LessonsAsync();editing=courses.FirstOrDefault(x=>x.Id==EditId);selected=courses.FirstOrDefault(x=>x.Id==CourseId);deleting=courses.FirstOrDefault(x=>x.Id==DeleteId);}
  catch(Exception){Notice="تعذر تحميل البيانات من PostgreSQL";}
 }
}
