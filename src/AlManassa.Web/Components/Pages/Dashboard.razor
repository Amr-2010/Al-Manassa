@page "/dashboard"
@rendermode InteractiveServer
@using AlManassa.Web
@inject CourseStore Store
@inject AuthStore Users
<PageTitle>لوحة الإدارة | المنصة</PageTitle>
<div class="dashboard" dir="rtl">
<aside class="sidebar"><div class="sidebar-brand">المنصة <small>Al-Manassa</small></div><nav><a href="/dashboard" class="selected">▦ نظرة عامة</a><a href="/">⌂ الموقع الرئيسي</a><a href="/dashboard/subjects">▦ إدارة الأقسام</a><a href="/dashboard/content">▤ إدارة الدورات</a><a href="/dashboard/content">✎ مراجعة وتعديل الدروس والفيديو</a><a href="#ai">✦ مقترحات الذكاء الاصطناعي</a><a href="#reports">◫ التقارير</a></nav><div class="side-note">لوحة الإدارة متاحة لحسابات Admin فقط.</div></aside>
<section class="dashboard-main"><div class="dash-top"><div><p class="overline">AL-MANASSA / MANAGEMENT</p><h1>لوحة التحكم الرئيسية</h1><p>بيانات مباشرة من PostgreSQL عند توفر الاتصال</p></div><a class="outline" href="/">عرض الموقع ←</a></div>
@if (error) {<div class="course-message">تعذر الاتصال بقاعدة البيانات. تحقق من DATABASE_URL ومن تنفيذ database/002_courses_and_seed.sql.</div>}
<div class="stat-grid"><div class="stat"><span>إجمالي الدورات</span><strong>@(error ? "—" : total.ToString())</strong><small>PostgreSQL</small></div><div class="stat"><span>الدورات المنشورة</span><strong>@(error ? "—" : published.ToString())</strong><small>PostgreSQL</small></div><div class="stat"><span>مقترحات المناهج</span><strong>@(error ? "—" : suggestions.ToString())</strong><small>محفوظة للمراجعة</small></div><div class="stat"><span>الطلاب</span><strong>@(error ? "—" : students.ToString())</strong><small>حسابات PostgreSQL</small></div></div>
<section class="panel" id="content-review"><div class="panel-heading"><div><span class="tag">CONTENT REVIEW</span><h2>مراجعة محتوى الدورات من PostgreSQL</h2></div></div><table><thead><tr><th>الدورة</th><th>المراحل</th><th>الدروس</th><th>الأسئلة</th><th>مقترحات الفيديو</th><th>الحالة</th></tr></thead><tbody>@foreach(var item in audit){<tr><td>@item.Course</td><td>@item.Stages</td><td>@item.Lessons</td><td>@item.Questions</td><td>@item.Videos</td><td>@(item.Stages>0 && item.Lessons>0 && item.Questions>=23?"قيد المراجعة":"محتوى غير مكتمل")</td></tr>}</tbody></table><p>الفيديوهات المقترحة لم تعتمد بعد، ولا تُعرض للطلاب إلا بعد التحقق من رابط قابل للتضمين وحقوق الاستخدام.</p></section><div class="dash-columns"><section class="panel" id="ai"><div class="panel-heading"><div><span class="tag">AI CURRICULUM</span><h2>مقترحات المناهج بالذكاء الاصطناعي</h2></div><span class="pill">OpenAI API</span></div><p>تمت إضافة واجهة خادم لتوليد مناهج حقيقية وحفظها في قاعدة البيانات بحالة PendingReview. يتم توليد مقترحات المناهج عبر خدمة الذكاء الاصطناعي وحفظها في PostgreSQL بحالة PendingReview. يلزم ربط واجهة الإدارة الآمنة بنقطة التوليد قبل إتاحة الإنشاء المباشر.</p><div class="empty">المتطلبات: OPENAI_API_KEY و AI_ADMIN_TOKEN و DATABASE_URL. لا يتم نشر المناهج تلقائيًا.</div></section>
<section class="panel" id="courses"><div class="panel-heading"><div><span class="tag">COURSE MANAGEMENT</span><h2>الدورات المنشورة</h2></div></div><table><thead><tr><th>الدورة</th><th>المدة</th><th>التصنيف</th></tr></thead><tbody>@foreach(var c in courses){<tr><td>@c.TitleAr</td><td>@c.DurationWeeks أسابيع</td><td>@c.Category</td></tr>}</tbody></table><div class="empty" id="reports">المدفوعات والاختبارات والطلاب ستظهر هنا بعد إنشاء الجداول ونظام المصادقة.</div></section></div>
</section></div>
@code {
 bool error; long total,published,suggestions,students; List<CourseItem> courses=new(); List<(string Course,int Stages,int Lessons,int Questions,int Videos)> audit=new();
 protected override async Task OnInitializedAsync(){
  try {var counts=await Store.CountsAsync();total=counts.Total;published=counts.Published;courses=await Store.PublishedAsync();suggestions=await Store.SuggestionCountAsync();students=await Users.CountStudentsAsync();audit=await Store.ContentAuditAsync();}
  catch(Exception){error=true;}
 }
}
