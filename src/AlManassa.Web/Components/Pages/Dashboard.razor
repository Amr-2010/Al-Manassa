@page "/dashboard"
@rendermode InteractiveServer
<PageTitle>لوحة الإدارة | المنصة</PageTitle>
<div class="dashboard" dir="rtl"><aside class="sidebar"><div class="sidebar-brand"><span class="brand-dot">▶</span> المنصة <small>Al-Manassa</small></div><nav><a href="/dashboard" class="selected">▦ نظرة عامة</a><a href="/">⌂ الموقع الرئيسي</a><a href="#courses">▤ إدارة الدورات</a><a href="#ai">✦ مقترحات المناهج</a><a href="#reports">◫ التقارير</a></nav><div class="side-note">نسخة تجريبية — بدون تسجيل دخول أو بيانات إنتاجية</div></aside><section class="dashboard-main"><div class="dash-top"><div><p class="overline">AL-MANASSA / ADMIN</p><h1>لوحة التحكم الرئيسية</h1><p>نظرة عامة على إدارة الدورات والمناهج المقترحة</p></div><a class="outline" href="/">عرض الموقع ←</a></div><div class="stat-grid"><div class="stat"><span>الدورات التجريبية</span><strong>3</strong><small>بيانات نموذجية</small></div><div class="stat"><span>الدورات المنشورة تجريبيًا</span><strong>2</strong><small>بيانات نموذجية</small></div><div class="stat"><span>الطلاب المسجلون</span><strong>0</strong><small>غير مربوط بقاعدة بيانات</small></div><div class="stat"><span>المناهج المقترحة</span><strong>@suggestions.Count</strong><small>خلال جلسة العرض</small></div></div><div class="dash-columns"><section class="panel" id="ai"><div class="panel-heading"><div><span class="tag">AI CURRICULUM</span><h2>مولد مقترحات المناهج</h2></div><span class="pill">نموذج قواعد — AI غير متصل</span></div><p>أنشئ تصورًا أوليًا للمنهج لمراجعته من الإدارة. لا يتم نشره تلقائيًا.</p><div class="form-grid"><label>عنوان التخصص<input @bind="topic" placeholder="مثال: الأمن السيبراني" /></label><label>المستوى<select @bind="level"><option>مبتدئ</option><option>متوسط</option><option>متقدم</option></select></label><label>المدة بالأسابيع<input type="number" min="1" max="16" @bind="weeks" /></label><label>اللغة<select @bind="language"><option>العربية</option><option>English</option></select></label></div><button @onclick="Generate">إنشاء مقترح للمراجعة ✦</button>@if(!string.IsNullOrEmpty(error)){<p class="error">@error</p>}@if(suggestions.Count>0){<div class="suggestions"><h3>المقترحات في هذه الجلسة</h3>@foreach(var s in suggestions){<article><strong>@s.Title</strong><span> @s.Level · @s.Weeks أسابيع · بانتظار المراجعة</span><ul>@for(int i=1;i<=Math.Min(s.Weeks,4);i++){<li>الأسبوع @i: مفاهيم وتطبيقات @s.Title</li>}</ul></article>}</div>}</section><section class="panel" id="courses"><div class="panel-heading"><div><span class="tag">COURSE MANAGEMENT</span><h2>إدارة الدورات</h2></div></div><table><thead><tr><th>الدورة</th><th>المدة</th><th>الحالة</th></tr></thead><tbody><tr><td>أساسيات الذكاء الاصطناعي</td><td>8 أسابيع</td><td>مسودة</td></tr><tr><td>تطوير تطبيقات .NET</td><td>6 أسابيع</td><td>منشورة تجريبيًا</td></tr><tr><td>التسويق الرقمي</td><td>4 أسابيع</td><td>منشورة تجريبيًا</td></tr></tbody></table><div class="empty" id="reports">تقارير الإيرادات والطلاب والاختبارات ستُفعّل بعد إضافة الحسابات وقاعدة البيانات.</div></section></div></section></div>
@code {
 string topic="الذكاء الاصطناعي"; string level="مبتدئ"; string language="العربية"; int weeks=8; string error="";
 List<Suggestion> suggestions=new();
 void Generate(){if(string.IsNullOrWhiteSpace(topic)||weeks<1||weeks>16){error="أدخل تخصصًا ومدة من 1 إلى 16 أسبوعًا";return;}error="";suggestions.Insert(0,new(topic.Trim(),level,language,weeks));}
 record Suggestion(string Title,string Level,string Language,int Weeks);
}
