@page "/dashboard"
@rendermode InteractiveServer
@attribute [Authorize(Roles="Admin")]
@using Microsoft.AspNetCore.Authorization
@using AlManassa.Web
@inject CourseStore Store
@inject AuthStore Users
<PageTitle>لوحة الإدارة | المنصة</PageTitle>
<div class="dashboard" dir="rtl">
<aside class="sidebar"><div class="sidebar-brand">المنصة <small>Al-Manassa</small></div><nav><a href="/dashboard" class="selected">▦ نظرة عامة</a><a href="/">⌂ الموقع الرئيسي</a><a href="/dashboard/subjects">▦ إدارة الأقسام</a><a href="/dashboard/content">▤ إدارة الدورات</a><a href="#content-review">◫ التقارير</a></nav><div class="side-note">لوحة الإدارة متاحة لحسابات Admin فقط.</div></aside>
<section class="dashboard-main"><div class="dash-top"><div><p class="overline">AL-MANASSA / MANAGEMENT</p><h1>لوحة التحكم الرئيسية</h1><p>بيانات الإدارة من PostgreSQL</p></div><a class="outline" href="/">عرض الموقع ←</a></div>
@if (error) {<div class="course-message">تعذر الاتصال بقاعدة البيانات. تحقق من DATABASE_URL ومن تنفيذ database/002_courses_and_seed.sql.</div>}
<div class="stat-grid" style="grid-template-columns:repeat(3,minmax(0,1fr))"><div class="stat"><span>الأقسام</span><strong>@(error ? "—" : sections.ToString())</strong><small>الأقسام الظاهرة</small></div><div class="stat"><span>الكورسات</span><strong>@(error ? "—" : total.ToString())</strong><small>إجمالي الكورسات</small></div><div class="stat"><span>الدروس</span><strong>@(error ? "—" : lessons.ToString())</strong><small>جميع الدروس</small></div><div class="stat"><span>الطلاب المسجلون</span><strong>@(error ? "—" : students.ToString())</strong><small>حسابات الطلاب</small></div><div class="stat"><span>الحاصلون على شهادة نهائية</span><strong>@(error ? "—" : certified.ToString())</strong><small>طلاب مميزون</small></div><div class="stat"><span>الطلاب على المنصة الآن</span><strong>@(error ? "—" : online.ToString())</strong><small>نشطون خلال آخر 5 دقائق</small></div></div>
<section class="panel" id="content-review"><div class="panel-heading"><div><span class="tag">CONTENT REVIEW</span><h2>مراجعة محتوى الدورات من PostgreSQL</h2></div></div><table><thead><tr><th>الدورة</th><th>المراحل</th><th>الدروس</th><th>الأسئلة</th><th>مقترحات الفيديو</th><th>الحالة</th></tr></thead><tbody>@foreach(var item in audit){<tr><td>@item.Course</td><td>@item.Stages</td><td>@item.Lessons</td><td>@item.Questions</td><td>@item.Videos</td><td>@(item.Stages>0 && item.Lessons>0 && item.Questions>=23?"قيد المراجعة":"محتوى غير مكتمل")</td></tr>}</tbody></table><p>الفيديوهات المقترحة لم تعتمد بعد، ولا تُعرض للطلاب إلا بعد التحقق من رابط قابل للتضمين وحقوق الاستخدام.</p></section><div class="dash-columns"><section class="panel" id="courses"><div class="panel-heading"><div><span class="tag">COURSE MANAGEMENT</span><h2>الدورات المنشورة</h2></div></div><table><thead><tr><th>الدورة</th><th>المدة</th><th>التصنيف</th></tr></thead><tbody>@foreach(var c in courses){<tr><td>@c.TitleAr</td><td>@c.DurationWeeks أسابيع</td><td>@c.Category</td></tr>}</tbody></table><div class="empty" id="reports"><strong>إدارة المحتوى</strong><p>أضف الدورات والدروس من لوحة إدارة المحتوى. تظهر هنا أعداد الدورات والطلاب الفعلية من قاعدة البيانات.</p><a class="outline" href="/dashboard/content">فتح محرر الدورات والدروس</a> <a class="outline" href="/dashboard/subjects">إدارة الأقسام</a></div></section></div>
</section></div>
@code {
 bool error; long sections,total,lessons,students,certified,online; List<CourseItem> courses=new(); List<(string Course,int Stages,int Lessons,int Questions,int Videos)> audit=new();
 protected override async Task OnInitializedAsync(){
  try {var counts=await Users.DashboardCountsAsync();sections=counts.Sections;total=counts.Courses;lessons=counts.Lessons;students=counts.Students;certified=counts.CertifiedStudents;online=counts.OnlineStudents;courses=await Store.PublishedAsync();audit=await Store.ContentAuditAsync();}
  catch(Exception){error=true;}
 }
}
