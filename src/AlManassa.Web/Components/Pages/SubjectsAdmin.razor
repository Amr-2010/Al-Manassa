@page "/dashboard/subjects"
@attribute [Authorize(Roles="Admin")]
@using Microsoft.AspNetCore.Authorization
@using AlManassa.Web
@inject CourseStore Store
<PageTitle>إدارة الأقسام | المنصة</PageTitle>
<main dir="rtl" class="category-admin">
 <a href="/dashboard">← لوحة الإدارة</a>
 <h1>إدارة الأقسام والتصنيفات</h1>
 <p>أضف الأقسام وعدّل بياناتها أو احذفها. تحفظ العمليات مباشرة في PostgreSQL.</p>
 @if(!string.IsNullOrWhiteSpace(notice)){<p role="status" class="category-notice">@notice</p>}
 <section id="category-editor" class="panel category-editor">
  <h2>@(current is null?"إضافة قسم جديد":"تعديل القسم: "+current.Name)</h2>
  <form method="post" action="/api/admin/subjects/save">
   <AntiforgeryToken />
   <div class="category-form">
    <label>معرّف القسم (بالإنجليزية)
      <input name="slug" value="@(current?.Key??"")" maxlength="100" required readonly="@(current is not null)" placeholder="Marketing" />
    </label>
    <label>اسم القسم بالعربية
      <input name="name" value="@(current?.Name??"")" maxlength="200" required placeholder="التسويق الرقمي" />
    </label>
    <label>رمز القسم
      <select name="icon" required aria-label="اختر رمز القسم">
       <option value="⌘" selected="@(current?.Icon == "⌘")">⌘ — برمجة</option>
       <option value="💻" selected="@(current?.Icon == "💻")">💻 — كمبيوتر</option>
       <option value="📱" selected="@(current?.Icon == "📱")">📱 — تطبيقات</option>
       <option value="🌐" selected="@(current?.Icon == "🌐")">🌐 — مواقع</option>
       <option value="🤖" selected="@(current?.Icon == "🤖")">🤖 — ذكاء اصطناعي</option>
       <option value="🧠" selected="@(current?.Icon == "🧠")">🧠 — تعلم آلي</option>
       <option value="🔐" selected="@(current?.Icon == "🔐")">🔐 — أمن سيبراني</option>
       <option value="🛡️" selected="@(current?.Icon == "🛡️")">🛡️ — حماية</option>
       <option value="📊" selected="@(current?.Icon == "📊")">📊 — تحليل بيانات</option>
       <option value="📈" selected="@(current?.Icon == "📈")">📈 — تسويق</option>
       <option value="💼" selected="@(current?.Icon == "💼")">💼 — أعمال</option>
       <option value="🏦" selected="@(current?.Icon == "🏦")">🏦 — مالية</option>
       <option value="🎨" selected="@(current?.Icon == "🎨")">🎨 — تصميم</option>
       <option value="📷" selected="@(current?.Icon == "📷")">📷 — تصوير</option>
       <option value="🎬" selected="@(current?.Icon == "🎬")">🎬 — فيديو</option>
       <option value="🎵" selected="@(current?.Icon == "🎵")">🎵 — موسيقى</option>
       <option value="📚" selected="@(current?.Icon == "📚")">📚 — تعليم</option>
       <option value="🎓" selected="@(current?.Icon == "🎓")">🎓 — شهادات</option>
       <option value="📝" selected="@(current?.Icon == "📝")">📝 — كتابة</option>
       <option value="🗣️" selected="@(current?.Icon == "🗣️")">🗣️ — لغات</option>
       <option value="🌍" selected="@(current?.Icon == "🌍")">🌍 — جغرافيا</option>
       <option value="🔬" selected="@(current?.Icon == "🔬")">🔬 — علوم</option>
       <option value="⚙️" selected="@(current?.Icon == "⚙️")">⚙️ — هندسة</option>
       <option value="🩺" selected="@(current?.Icon == "🩺")">🩺 — صحة</option>
       <option value="🏋️" selected="@(current?.Icon == "🏋️")">🏋️ — رياضة</option>
       <option value="🧩" selected="@(current?.Icon == "🧩")">🧩 — مهارات</option>
       <option value="🚀" selected="@(current?.Icon == "🚀")">🚀 — تطوير</option>
       <option value="🏠" selected="@(current?.Icon == "🏠")">🏠 — عقارات</option>
       <option value="🚗" selected="@(current?.Icon == "🚗")">🚗 — سيارات</option>
       <option value="🛒" selected="@(current?.Icon == "🛒")">🛒 — تجارة</option>
       <option value="💡" selected="@(current?.Icon == "💡")">💡 — ابتكار</option>
       <option value="📡" selected="@(current?.Icon == "📡")">📡 — شبكات</option>
       <option value="☁️" selected="@(current?.Icon == "☁️")">☁️ — سحابة</option>
       <option value="🖥️" selected="@(current?.Icon == "🖥️")">🖥️ — تقنية</option>
       <option value="🎯" selected="@(current?.Icon == "🎯")">🎯 — أهداف</option>
       <option value="✦" selected="@(current?.Icon == "✦")">✦ — نجمة</option>
       <option value="◆" selected="@(current?.Icon == "◆")">◆ — معين</option>
       <option value="◇" selected="@(current?.Icon == "◇")">◇ — معين فارغ</option>
       <option value="◈" selected="@(current?.Icon == "◈")">◈ — شكل هندسي</option>
       <option value="✳" selected="@(current?.Icon == "✳")">✳ — زخرفة</option>
       <option value="◎" selected="@(current?.Icon == "◎")">◎ — دائرة</option>
       <option value="⚙" selected="@(current?.Icon == "⚙")">⚙ — ترس</option>
       <option value="✎" selected="@(current?.Icon == "✎")">✎ — قلم</option>
       <option value="✚" selected="@(current?.Icon == "✚")">✚ — صليب</option>
       <option value="▥" selected="@(current?.Icon == "▥")">▥ — أعمدة</option>
       <option value="✧" selected="@(current?.Icon == "✧")">✧ — بريق</option>
       <option value="文" selected="@(current?.Icon == "文")">文 — لغات</option>
       <option value="⌘" selected="@(current?.Icon == "⌘")">⌘ — برمجة (رمز)</option>
       @if(current is not null && !new[]{"⌘","💻","📱","🌐","🤖","🧠","🔐","🛡️","📊","📈","💼","🏦","🎨","📷","🎬","🎵","📚","🎓","📝","🗣️","🌍","🔬","⚙️","🩺","🏋️","🧩","🚀","🏠","🚗","🛒","💡","📡","☁️","🖥️","🎯","✦","◆","◇","◈","✳","◎","⚙","✎","✚","▥","✧","文"}.Contains(current.Icon)){<option value="@current.Icon" selected>@current.Icon — الرمز الحالي</option>}
      </select>
    </label>
    <label>وصف القسم
      <textarea name="description" maxlength="3000" rows="4" placeholder="اكتب وصف القسم ومجالاته التعليمية">@(current?.Description??"")</textarea>
    </label>
   </div>
   <button type="submit">@(current is null?"إضافة القسم":"حفظ التعديلات")</button>
   @if(current is not null){<a class="outline" href="/dashboard/subjects">إلغاء التعديل</a>}
  </form>
 </section>
 <section class="panel">
  <h2>الأقسام المسجلة (@subjects.Count)</h2>
  <div class="admin-category-grid">
   @foreach(var subject in subjects){
    <article><span class="admin-category-icon">@subject.Icon</span><h3>@subject.Name</h3>
     <small>@subject.Key — @(subject.Active?"ظاهر":"مخفي")</small>
     <p>@subject.Description</p>
     <div class="category-actions">
      <a class="category-edit-link" href="@("/dashboard/subjects?edit="+Uri.EscapeDataString(subject.Key)+"#category-editor")">تعديل</a>
      <a class="category-edit-link" href="@("/dashboard/subjects?delete="+Uri.EscapeDataString(subject.Key)+"#delete-confirmation")">حذف</a>
     </div>
    </article>
   }
  </div>
  @if(deleteTarget is not null){
   <div class="category-notice" id="delete-confirmation">
    <strong>تأكيد حذف القسم: @deleteTarget.Name</strong>
    <p>إذا كان القسم مرتبطًا بكورسات، سيتم إخفاؤه مع الاحتفاظ ببيانات الطلاب والكورسات.</p>
    <form method="post" action="/api/admin/subjects/delete">
     <AntiforgeryToken />
     <input type="hidden" name="slug" value="@deleteTarget.Key" />
     <button type="submit">تأكيد الحذف</button>
     <a href="/dashboard/subjects">إلغاء</a>
    </form>
   </div>
  }
 </section>
</main>
@code {
 [SupplyParameterFromQuery(Name="edit")] public string? EditKey {get;set;}
 [SupplyParameterFromQuery(Name="delete")] public string? DeleteKey {get;set;}
 [SupplyParameterFromQuery(Name="notice")] public string? Notice {get;set;}
 List<SubjectItem> subjects=new();
 SubjectItem? current,deleteTarget;
 string? notice;
 protected override async Task OnParametersSetAsync(){
  try {
   subjects=await Store.AllSubjectsAsync();
   current=subjects.FirstOrDefault(x=>x.Key==EditKey);
   deleteTarget=subjects.FirstOrDefault(x=>x.Key==DeleteKey);
   notice=Notice;
  }catch(Exception){notice="تعذر تحميل الأقسام من قاعدة البيانات";}
 }
}
