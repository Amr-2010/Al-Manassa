@page "/dashboard/subjects"
@rendermode InteractiveServer
@attribute [Authorize(Roles="Admin")]
@using Microsoft.AspNetCore.Authorization
@using AlManassa.Web
@inject CourseStore Store
<PageTitle>إدارة الأقسام | المنصة</PageTitle>
<main dir="rtl" class="category-admin">
 <a href="/dashboard">← لوحة الإدارة</a>
 <h1>إدارة الأقسام والتصنيفات</h1>
 <p>جميع التغييرات تحفظ في قاعدة PostgreSQL وتظهر في الصفحة الرئيسية.</p>
 @if(message is not null){<p role="status" class="category-notice">@message</p>}
 <section class="panel category-editor">
  <h2>@(editing?"تعديل القسم":"إضافة قسم جديد")</h2>
  <div class="category-form">
   <label>معرّف القسم (بالإنجليزية)<input @bind="slug" disabled="@editing" maxlength="100" placeholder="Marketing" /></label>
   <label>اسم القسم بالعربية<input @bind="name" maxlength="200" placeholder="التسويق الرقمي" /></label>
   <label>رمز القسم<input @bind="icon" maxlength="20" placeholder="◆" /></label>
  </div>
  <button @onclick="Save">@(editing?"حفظ التعديلات":"إضافة القسم")</button>
  <button @onclick="Reset">قسم جديد</button>
 </section>
 <section class="panel">
  <h2>الأقسام المسجلة (@subjects.Count)</h2>
  <div class="admin-category-grid">
   @foreach(var subject in subjects){
    <article><span class="admin-category-icon">@subject.Icon</span><h3>@subject.Name</h3><small>@subject.Key</small>
     <div class="category-actions"><button @onclick="()=>Edit(subject)">تعديل</button><button @onclick="()=>Delete(subject.Key)">حذف</button></div>
    </article>
   }
  </div>
 </section>
</main>
@code {
 List<SubjectItem> subjects=new();
 string slug="",name="",icon="◆";bool editing;string? message;
 protected override async Task OnInitializedAsync()=>await Reload();
 async Task Reload(){try{subjects=await Store.AllSubjectsAsync();}catch(Exception){message="تعذر تحميل الأقسام من PostgreSQL";}}
 void Edit(SubjectItem s){slug=s.Key;name=s.Name;icon=s.Icon;editing=true;}
 void Reset(){slug="";name="";icon="◆";editing=false;}
 async Task Save(){try{await Store.SaveSubjectAsync(slug,name,icon);message="تم حفظ القسم في قاعدة البيانات";Reset();await Reload();}catch(Exception){message="تعذر الحفظ؛ تحقق من البيانات واتصال قاعدة البيانات";}}
 async Task Delete(string key){try{await Store.DeleteSubjectAsync(key);message="تم حذف القسم";await Reload();}catch(Exception){message="لا يمكن حذف قسم مرتبط بدورات. انقل الدورات أولًا ثم حاول مجددًا.";}}
}