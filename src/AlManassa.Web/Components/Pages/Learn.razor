@page "/learn/{CourseId:guid}"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using AlManassa.Web
@inject LearningStore Learning
@inject LessonMediaStore Media
@inject AuthenticationStateProvider Authentication
<PageTitle>دورتي التعليمية | المنصة</PageTitle>
<div class="learning-page" dir="rtl">
 <header class="learning-header"><a href="/">المنصة · Al-Manassa</a><nav aria-label="التنقل"><a href="/">الرئيسية</a> · <a href="/#courses">الدورات</a> · <a href="/#pathways">المسارات</a> · <a href="/#certificates">الشهادات</a> · <a href="/dashboard">لوحة التحكم</a></nav><span>مساري التعليمي</span></header>
 <main>
 <h1>@(courseTitle ?? "مراحل الدورة التعليمية")</h1>
 @if(!string.IsNullOrWhiteSpace(courseDescription)){<p class="learning-description">@courseDescription</p>}
 <h2>مراحل الدورة التعليمية</h2>
 @if(courseTitle is null){<div class="learning-notice">تعذر العثور على هذه الدورة أو أنها غير منشورة. <a href="/">العودة إلى الدورات</a></div>}
 else if(stages.Count==0){<div class="learning-notice">محتوى هذه الدورة لم يُنشر بعد. لا توجد مراحل تعليمية متاحة حاليًا. يرجى مراجعة إدارة المنصة.</div>}
 @if(!string.IsNullOrWhiteSpace(message)){<div class="learning-notice">@message</div>}
 @if(courseTitle is not null && stages.Count>0 && !enrolled){<p>سجّل في الدورة للوصول إلى المحتوى.</p><button @onclick="Enroll">التحاق بالدورة</button>}
 else if(enrolled && stages.Count>0) {
 <p>المراحل المكتملة: @stages.Count(x=>x.Passed) من @stages.Count</p>
 <button @onclick="ResumeLearning">استكمال التعلم من آخر مرحلة</button>
 <div class="learning-stages">
 @foreach(var stage in stages){
 <button class="learning-stage @(stage.Passed?"completed":"")" @onclick="()=>OpenStage(stage.Id)">
  <strong>@stage.Position. @stage.Title</strong><span>@(stage.Passed?"✓ اجتازت":"عرض المرحلة")</span>
 </button>
 }
 </div>
 @if(activeStage is Guid sid){
 <section class="learning-panel"><h2>الدروس</h2>
 @foreach(var lesson in lessons){
 <article class="learning-lesson"><h3>@lesson.Title</h3><p>@lesson.Content</p>
 @if(lesson.VideoProvider=="youtube" && IsYoutubeId(lesson.VideoReference)){
 <iframe class="learning-video" src="@($"https://www.youtube-nocookie.com/embed/{lesson.VideoReference}")" title="@lesson.Title" allow="accelerometer; autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>
 }else if(lesson.VideoProvider=="hosted" && IsSafeHostedUrl(lesson.VideoReference)){
 <video class="learning-video" controls controlsList="nodownload" preload="metadata" src="@lesson.VideoReference"></video>
 }
 @if(lesson.VideoProvider=="link" && IsSafeHostedUrl(lesson.VideoReference)){<p><a href="@lesson.VideoReference" target="_blank" rel="noopener noreferrer">فتح رابط الشرح</a></p>}
 @if(lesson.VideoProvider=="image" && IsSafeHostedUrl(lesson.VideoReference)){<img src="@lesson.VideoReference" alt="@lesson.Title" style="max-width:100%;height:auto;border-radius:12px" loading="lazy" />}
 @if(lessonAssets.TryGetValue(lesson.Id,out var assets)){
 @foreach(var asset in assets){
 @if(asset.Mime.StartsWith("image/")){<img src="@($"/api/lesson-assets/{asset.Id}")" alt="@asset.Filename" loading="lazy" style="max-width:100%;height:auto" />}
 else{<p><a href="@($"/api/lesson-assets/{asset.Id}")" target="_blank" rel="noopener">@asset.Filename (PDF)</a></p>}
 }}
 <p>آخر موضع محفوظ للفيديو: @(positions.GetValueOrDefault(lesson.Id)) ثانية</p>
 <label>الموضع الحالي بالثواني <input type="number" min="0" max="86400" @bind="positionInput[lesson.Id]" /></label>
 <button @onclick="()=>SavePlayback(lesson.Id)">حفظ موضع الفيديو</button>
 <button disabled="@lesson.Completed" @onclick="()=>Complete(lesson.Id)">@(lesson.Completed?"تم إكمال الدرس":"تحديد الدرس مكتملًا")</button>
 </article>
 }
 <h2>اختبار المرحلة</h2>
 @if(questions.Count==0){<p>لم تُضف أسئلة لهذه المرحلة بعد. لا يمكن اجتيازها قبل إعداد الاختبار.</p>}
 else { @foreach(var q in questions){<fieldset class="learning-question"><legend>@q.Prompt</legend>@foreach(var o in q.Options){<label><input type="radio" name="@q.Id" checked="@(answers.GetValueOrDefault(q.Id)==o.Id)" @onchange="()=>Choose(q.Id,o.Id)" /> @o.Label</label>}</fieldset>}
 <button @onclick="SubmitStage" disabled="@(answers.Count!=questions.Count)">تسليم اختبار المرحلة</button> }
 </section>
 }
 <section class="learning-panel"><h2>الامتحان النهائي</h2><p>20 سؤالًا بعد اجتياز جميع المراحل. النجاح من 70%.</p>
 @if(finalQuestions.Count>0){
 @foreach(var q in finalQuestions){<fieldset class="learning-question"><legend>@q.Prompt</legend>@foreach(var o in q.Options){<label><input type="radio" name="@q.Id" checked="@(finalAnswers.GetValueOrDefault(q.Id)==o.Id)" @onchange="()=>ChooseFinal(q.Id,o.Id)" /> @o.Label</label>}</fieldset>}
 <button disabled="@(finalAnswers.Count!=20)" @onclick="SubmitFinal">تسليم الامتحان النهائي</button>
 }else{<button @onclick="LoadFinal">فتح الامتحان النهائي</button>}
 </section>
 @if(certificate is not null){<section class="learning-certificate certificate-official" id="certificate" style="background:#08244a;color:#fff;border:9px double #ffbf36;border-radius:18px;text-align:center;padding:42px 20px;margin:30px auto;max-width:900px">
 <img src="/Al-Manassa%20Media%20Logo.png" alt="شعار المنصة" style="max-width:190px;max-height:105px;object-fit:contain" />
 <h2 style="color:#ffc344;font-size:34px">شهادة إتمام دورة تدريبية</h2>
 <p>تشهد منصة Al-Manassa بأن</p><h3 style="font-size:28px;color:#ffdc7d">@certificate.StudentEmail</h3>
 <p>قد أتم بنجاح متطلبات الدورة التدريبية</p><h3 style="font-size:26px">@certificate.CourseTitle</h3>
 <p>واجتاز الاختبار النهائي وفق معايير المنصة</p>
 <p>تاريخ الإصدار: @certificate.IssuedAt.ToString("yyyy-MM-dd")</p>
 <p style="font-size:12px">رقم التحقق: @certificate.Code</p>
 <p><a style="color:#ffdc7d" href="@($"/verify/{certificate.Code}")">التحقق من صحة الشهادة</a></p>
 <button class="certificate-print" onclick="window.print()">طباعة / حفظ الشهادة PDF</button>
 </section>}
 }
 </main>
</div>
@code{
 [Parameter] public Guid CourseId{get;set;}
 string? courseTitle,courseDescription;
 Guid userId;bool enrolled;Guid? activeStage;string? message;
 List<StageInfo> stages=new();List<LessonInfo> lessons=new();List<QuestionInfo> questions=new();List<QuestionInfo> finalQuestions=new();
 Dictionary<Guid,List<(Guid Id,string Filename,string Mime)>> lessonAssets=new();
 Dictionary<Guid,int> positions=new(),positionInput=new();
 Dictionary<Guid,Guid> answers=new();Dictionary<Guid,Guid> finalAnswers=new();CertificateInfo? certificate;
 protected override async Task OnInitializedAsync(){
   var state=await Authentication.GetAuthenticationStateAsync();
   if(!Guid.TryParse(state.User.FindFirstValue(ClaimTypes.NameIdentifier),out userId)){message="يجب تسجيل الدخول أولًا";return;}
   try {var info=await Learning.CourseInfoAsync(CourseId);courseTitle=info?.Title;courseDescription=info?.Description;await Refresh();}
   catch(Exception){message="تعذر تحميل محتوى الدورة من قاعدة البيانات. يرجى المحاولة لاحقًا.";}
 }
 async Task Refresh(){
   stages=await Learning.StagesAsync(userId,CourseId);
   enrolled=stages.Any(s=>s.Enrolled);
   certificate=await Learning.CertificateAsync(userId,CourseId);
 }
 async Task Enroll(){enrolled=await Learning.EnrollAsync(userId,CourseId);await Refresh();if(!enrolled)message="الدورة غير متاحة للتسجيل";}
 async Task ResumeLearning(){
   var stageId=await Learning.ResumeStageAsync(userId,CourseId);
   if(stageId is Guid id)await OpenStage(id);
   else message="لقد أكملت جميع مراحل هذه الدورة.";
 }
 async Task OpenStage(Guid id){
   if(!await Learning.CanAccessStageAsync(userId,id)){message="يجب إكمال المراحل السابقة واجتياز اختباراتها أولًا";return;}
   activeStage=id;lessons=await Learning.LessonsAsync(userId,id);questions=await Learning.QuestionsAsync(userId,CourseId,id);
   lessonAssets.Clear();positions.Clear();positionInput.Clear();
   foreach(var lesson in lessons){lessonAssets[lesson.Id]=await Media.ListAsync(lesson.Id,userId);positions[lesson.Id]=await Media.PositionAsync(userId,lesson.Id);positionInput[lesson.Id]=positions[lesson.Id];}
   answers.Clear();message=null;
 }
 async Task SavePlayback(Guid id){await Media.SavePositionAsync(userId,id,positionInput.GetValueOrDefault(id));positions[id]=positionInput.GetValueOrDefault(id);message="تم حفظ موضع الفيديو في قاعدة البيانات";}
 async Task Complete(Guid id){await Learning.CompleteLessonAsync(userId,id);if(activeStage is Guid sid)lessons=await Learning.LessonsAsync(userId,sid);}
 void Choose(Guid q,Guid o)=>answers[q]=o;
 void ChooseFinal(Guid q,Guid o)=>finalAnswers[q]=o;
 async Task SubmitStage(){
   if(activeStage is not Guid sid)return;
   var result=await Learning.SubmitAsync(userId,CourseId,sid,answers);
   message=$"{result.Message} — {result.Score}%";await Refresh();
 }
 async Task LoadFinal(){
   if(stages.Count==0 || stages.Any(s=>!s.Passed)){message="أكمل جميع المراحل أولًا";return;}
   var qs=await Learning.QuestionsAsync(userId,CourseId,null);
   if(qs.Count!=20){message="الامتحان النهائي غير مكتمل (يلزم 20 سؤالًا)";return;}
   finalQuestions=qs;finalAnswers.Clear();message=null;
 }
 async Task SubmitFinal(){
   var result=await Learning.SubmitAsync(userId,CourseId,null,finalAnswers);
   message=$"{result.Message} — {result.Score}%";await Refresh();
 }
 static bool IsYoutubeId(string? id)=>id is {Length:11} && id.All(c=>char.IsAsciiLetterOrDigit(c)||c=='_'||c=='-');
 static bool IsSafeHostedUrl(string? url)=>Uri.TryCreate(url,UriKind.Absolute,out var uri)&&uri.Scheme==Uri.UriSchemeHttps;
}
