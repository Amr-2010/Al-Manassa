@page "/learn/{CourseId:guid}"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using AlManassa.Web
@inject LearningStore Learning
@inject LessonMediaStore Media
@inject AuthenticationStateProvider Authentication
@inject ILogger<Learn> Logger
@inject IJSRuntime JS
@implements IAsyncDisposable
@using Microsoft.JSInterop
<PageTitle>دورتي التعليمية | المنصة</PageTitle>
<div class="learning-page" dir="rtl">
 <header class="learning-header"><a href="/">المنصة · Al-Manassa</a><nav aria-label="التنقل"><a href="/">الرئيسية</a> · <a href="/#courses">الدورات</a> · <a href="/dashboard">لوحة التحكم</a></nav><span>مساري التعليمي</span></header>
 <main class="learning-main blended-learning"><div class="learning-course-heading"><span class="learning-eyebrow">AL-MANASSA · COURSE PLAYER</span>
 <h1>@(courseTitle ?? "الكورس التعليمي")</h1>
 @if(!string.IsNullOrWhiteSpace(courseDescription)){<p class="learning-description">@courseDescription</p>}</div>
 <div class="learning-course-shell"><aside class="learning-outline"><h2>محتويات الكورس (@publicLessons.Count)</h2>
 @if(publicLessons.Count>0){<div class="public-lesson-list">@foreach(var item in publicLessons.Select((lesson,index)=>(lesson,index))){<div class="public-lesson-row"><span class="public-lesson-number">@(item.index+1)</span><strong>@item.lesson.Title</strong><span class="public-lesson-status">@(enrolled?"متاح بعد فتح الدرس":"سجّل في الكورس لبدء التعلم")</span></div>}</div>}
 else if(courseTitle is not null){<div class="learning-notice">هذا الكورس منشور لكن لا توجد دروس مضافة له في قاعدة البيانات حتى الآن. يجب إضافة الدروس من لوحة الإدارة.</div>}</aside><div class="learning-course-body">
 @if(courseTitle is null){<div class="learning-notice">تعذر العثور على هذه الدورة أو أنها غير منشورة. <a href="/">العودة إلى الدورات</a></div>}
 
 @if(EnrollmentError==1){<div class="learning-notice" role="alert">تعذر تسجيلك في الكورس. تأكد من اتصال المنصة بقاعدة البيانات ثم حاول مرة أخرى.</div>}
 @if(!string.IsNullOrWhiteSpace(message)){<div class="learning-notice">@message</div>}
 @if(courseTitle is not null && stages.Count>0 && !enrolled){<p>سجّل في الدورة للوصول إلى المحتوى.</p><form method="post" action="@($"/api/courses/{CourseId}/enroll")"><AntiforgeryToken /><button type="submit" class="enroll-submit">التحاق بالدورة</button></form>}
 else if(enrolled && stages.Count>0) {
 <div class="learning-progress-summary"><span>تقدمك في الكورس</span><strong>@(publicLessons.Count==0?0:100*publicLessons.Count(x=>lessons.Any(l=>l.Id==x.Id && l.Completed))/publicLessons.Count)%</strong></div>
 <a class="enroll-submit" href="@($"/learn/{CourseId}?stage={stages.FirstOrDefault(x=>!x.Passed)?.Id ?? stages[0].Id}")">استكمال التعلم</a>
 <div class="learning-stages">
 @foreach(var stage in stages){
 <a class="learning-stage @(stage.Passed?"completed":"")" href="@($"/learn/{CourseId}?stage={stage.Id}")">
  <strong>متابعة الدروس @(stages.Count>1?$"· الجزء {stage.Position}":"")</strong><span>@(stage.Passed?"✓ مكتمل":"فتح الدروس")</span>
 </a>
 }
 </div>
 @if(activeStage is Guid sid){
 <section class="learning-panel"><h2>الدروس</h2>
 @foreach(var lesson in lessons){
 <article class="learning-lesson"><h3>@lesson.Title</h3><p>@lesson.Content</p>
 @if(lesson.VideoProvider=="youtube" && IsYoutubeId(lesson.VideoReference)){
 <iframe class="learning-video" id="@($"lesson-video-{lesson.Id}")" src="@($"https://www.youtube.com/embed/{lesson.VideoReference}?enablejsapi=1&playsinline=1")" title="@lesson.Title" allow="accelerometer; autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>
 }else if(lesson.VideoProvider=="hosted"){
 <video class="learning-video" id="@($"lesson-video-{lesson.Id}")" controls controlsList="nodownload" preload="metadata" src="@($"/api/lessons/{lesson.Id}/video")"></video>
 }
 @if(string.IsNullOrWhiteSpace(lesson.VideoProvider) || (lesson.VideoProvider=="youtube" && !IsYoutubeId(lesson.VideoReference))){<p class="learning-notice">لم يتم ربط فيديو بهذا الدرس بعد. يمكن للإدارة إضافة رابط YouTube أو رفع فيديو من لوحة إدارة الدروس.</p>}
 @if(lesson.VideoProvider=="link" && IsSafeHostedUrl(lesson.VideoReference)){<p><a href="@lesson.VideoReference" target="_blank" rel="noopener noreferrer">فتح رابط الشرح</a></p>}
 @if(lesson.VideoProvider=="image" && IsSafeHostedUrl(lesson.VideoReference)){<img src="@lesson.VideoReference" alt="@lesson.Title" style="max-width:100%;height:auto;border-radius:12px" loading="lazy" />}
 @if(lessonAssets.TryGetValue(lesson.Id,out var assets)){
 @foreach(var asset in assets){
 @if(asset.Mime.StartsWith("image/")){<img src="@($"/api/lesson-assets/{asset.Id}")" alt="@asset.Filename" loading="lazy" style="max-width:100%;height:auto" />}
 else{<p><a href="@($"/api/lesson-assets/{asset.Id}")" target="_blank" rel="noopener">@asset.Filename (PDF)</a></p>}
 }}
 @if(lesson.VideoProvider is "youtube" or "hosted"){
 <p class="video-watch-status">@(lesson.Completed?"✓ اكتمل الدرس":watchedVideos.Contains(lesson.Id)?"✓ انتهى الفيديو، جارٍ تسجيل إكمال الدرس":"شاهد الفيديو كاملًا دون تقديمه لفتح الدرس التالي تلقائيًا")</p>
 }else if(!lesson.Completed){<p class="learning-notice">يلزم ربط فيديو بالدرس قبل السماح بإكماله.</p>}
 @if(lesson.Completed){<span class="lesson-completed-label">✓ تم إكمال الدرس</span>}else if(watchedVideos.Contains(lesson.Id)){<button disabled="@completingLesson" @onclick="()=>Complete(lesson.Id)">إعادة محاولة تسجيل الإكمال</button>}
 </article>
 }
 <h2>أسئلة الدروس</h2>
 @if(questions.Count==0){<p>لم تُضف أسئلة لهذا الجزء بعد.</p>}
 else { @foreach(var q in questions){<fieldset class="learning-question"><legend>@q.Prompt</legend>@foreach(var o in q.Options){<label><input type="radio" name="@q.Id" checked="@(answers.GetValueOrDefault(q.Id)==o.Id)" @onchange="()=>Choose(q.Id,o.Id)" /> @o.Label</label>}</fieldset>}
 <button @onclick="SubmitStage" disabled="@(answers.Count!=questions.Count)">تسليم أسئلة الدروس</button> }
 </section>
 }
 <section class="learning-panel"><h2>الامتحان النهائي</h2><p>20 سؤالًا بعد إكمال الدروس المطلوبة. النجاح من 70%.</p>
 @if(finalQuestions.Count>0){
 @foreach(var q in finalQuestions){<fieldset class="learning-question"><legend>@q.Prompt</legend>@foreach(var o in q.Options){<label><input type="radio" name="@q.Id" checked="@(finalAnswers.GetValueOrDefault(q.Id)==o.Id)" @onchange="()=>ChooseFinal(q.Id,o.Id)" /> @o.Label</label>}</fieldset>}
 <button disabled="@(finalAnswers.Count!=20)" @onclick="SubmitFinal">تسليم الامتحان النهائي</button>
 }else{<button @onclick="LoadFinal">فتح الامتحان النهائي</button>}
 </section>
 @if(certificate is not null){<section class="learning-certificate certificate-official" id="certificate" style="background:#08244a;color:#fff;border:9px double #ffbf36;border-radius:18px;text-align:center;padding:42px 20px;margin:30px auto;max-width:900px">
 <img src="/Al-Manassa%20Media%20Logo.png" alt="شعار المنصة" style="max-width:190px;max-height:105px;object-fit:contain" />
 <h2 style="color:#ffc344;font-size:34px">شهادة إتمام دورة تدريبية</h2>
 <p>تشهد منصة Al-Manassa بأن</p><h3 style="font-size:28px;color:#ffdc7d">@certificate.StudentEmail</h3>
 <p>قد أتم بنجاح متطلبات الدورة التدريبية</p><h3 style="font-size:26px">@certificate.CourseTitle</h3>
 <p>واجتاز الاختبار النهائي وفق معايير المنصة</p>
 <p>تاريخ الإصدار: @certificate.IssuedAt.ToString("yyyy-MM-dd")</p>
 <p style="font-size:12px">رقم التحقق: @certificate.Code</p>
 <p><a style="color:#ffdc7d" href="@($"/verify/{certificate.Code}")">التحقق من صحة الشهادة</a></p>
 <button class="certificate-print" onclick="window.print()">طباعة / حفظ الشهادة PDF</button>
 </section>}
 }
 </div></div></main>
</div>
@code{
 [Parameter] public Guid CourseId{get;set;}
 [SupplyParameterFromQuery(Name="enrollmentError")] public int? EnrollmentError {get;set;}
 [SupplyParameterFromQuery(Name="stage")] public Guid? RequestedStage {get;set;}
 string? courseTitle,courseDescription;
 Guid userId;bool enrolled;Guid? activeStage;string? message;
 List<(Guid Id,string Title)> publicLessons=new();
 List<StageInfo> stages=new();List<LessonInfo> lessons=new();List<QuestionInfo> questions=new();List<QuestionInfo> finalQuestions=new();
 Dictionary<Guid,List<(Guid Id,string Filename,string Mime)>> lessonAssets=new();
 Dictionary<Guid,int> positions=new(),positionInput=new();
 HashSet<Guid> watchedVideos=new();bool completingLesson;DotNetObjectReference<Learn>? videoCallback;
 Dictionary<Guid,Guid> answers=new();Dictionary<Guid,Guid> finalAnswers=new();CertificateInfo? certificate;
 protected override async Task OnInitializedAsync(){
   var state=await Authentication.GetAuthenticationStateAsync();
   if(!Guid.TryParse(state.User.FindFirstValue(ClaimTypes.NameIdentifier),out userId)){message="يجب تسجيل الدخول أولًا";return;}
   try {var info=await Learning.CourseInfoAsync(CourseId);courseTitle=info?.Title;courseDescription=info?.Description;publicLessons=await Learning.PublicLessonTitlesAsync(CourseId);await Refresh();if(enrolled && stages.Count>0)await OpenStage(RequestedStage is Guid requested && stages.Any(x=>x.Id==requested)?requested:stages[0].Id);}
   catch(Exception ex){Logger.LogError(ex,"Failed to load course {CourseId} for learner",CourseId);message="تعذر تحميل بعض محتويات الكورس. يرجى المحاولة لاحقًا.";}
 }
 async Task Refresh(){
   stages=await Learning.StagesAsync(userId,CourseId);
   enrolled=stages.Any(s=>s.Enrolled);
   certificate=await Learning.CertificateAsync(userId,CourseId);
 }
 async Task Enroll(){enrolled=await Learning.EnrollAsync(userId,CourseId);await Refresh();if(!enrolled)message="الدورة غير متاحة للتسجيل";else if(stages.Count>0)await OpenStage(stages[0].Id);}
 async Task ResumeLearning(){
   var stageId=await Learning.ResumeStageAsync(userId,CourseId);
   if(stageId is Guid id)await OpenStage(id);
   else message="لقد أكملت جميع مراحل هذه الدورة.";
 }
 async Task OpenStage(Guid id){
   if(!await Learning.CanAccessStageAsync(userId,id)){message="يجب إكمال المراحل السابقة واجتياز اختباراتها أولًا";return;}
   activeStage=id;lessons=await Learning.LessonsAsync(userId,id);
   try{questions=await Learning.QuestionsAsync(userId,CourseId,id);}catch(Exception ex){Logger.LogError(ex,"Failed to load questions for course {CourseId} and stage {StageId}",CourseId,id);questions=new();}
   lessonAssets.Clear();positions.Clear();positionInput.Clear();
   foreach(var lesson in lessons){
    try{lessonAssets[lesson.Id]=await Media.ListAsync(lesson.Id,userId);}catch(Exception ex){Logger.LogWarning(ex,"Failed to load attachments for lesson {LessonId}",lesson.Id);lessonAssets[lesson.Id]=new();}
    try{positions[lesson.Id]=await Media.PositionAsync(userId,lesson.Id);}catch(Exception ex){Logger.LogWarning(ex,"Failed to load playback position for lesson {LessonId}",lesson.Id);positions[lesson.Id]=0;}
    positionInput[lesson.Id]=positions.GetValueOrDefault(lesson.Id);
   }
   watchedVideos.Clear();answers.Clear();message=null;
 }
 protected override async Task OnAfterRenderAsync(bool firstRender){
  if(!enrolled||lessons.Count==0)return;
  try{
   videoCallback ??= DotNetObjectReference.Create(this);
   await JS.InvokeVoidAsync("alManassaWatch.attach",videoCallback,lessons.Where(l=>!l.Completed && l.VideoProvider is "youtube" or "hosted").Select(l=>new {id=l.Id.ToString(),provider=l.VideoProvider}).ToArray());
  }catch(JSException ex){Logger.LogWarning(ex,"Video watch monitoring unavailable");}
 }
 [JSInvokable] public async Task VideoEnded(string lessonId){
  if(Guid.TryParse(lessonId,out var id) && lessons.Any(l=>l.Id==id && !l.Completed && l.VideoProvider is "youtube" or "hosted")){
   try{await Learning.MarkVideoWatchedAsync(userId,id);watchedVideos.Add(id);await InvokeAsync(StateHasChanged);await Complete(id);await InvokeAsync(StateHasChanged);}catch(Exception ex){Logger.LogError(ex,"Could not record video completion {LessonId}",id);message="تعذر تسجيل انتهاء الفيديو. حاول إعادة تحميل الصفحة.";await InvokeAsync(StateHasChanged);}
  }
 }
 public async ValueTask DisposeAsync(){videoCallback?.Dispose();await Task.CompletedTask;}
 void UpdatePosition(Guid id,string? raw){if(int.TryParse(raw,out var seconds))positionInput[id]=Math.Clamp(seconds,0,86400);}
 async Task SavePlayback(Guid id){await Media.SavePositionAsync(userId,id,positionInput.GetValueOrDefault(id));positions[id]=positionInput.GetValueOrDefault(id);message="تم حفظ موضع الفيديو في قاعدة البيانات";}
 async Task Complete(Guid id){if(!watchedVideos.Contains(id)||completingLesson)return;completingLesson=true;try{var ok=await Learning.CompleteLessonAsync(userId,id);message=ok?"تم إكمال الدرس بنجاح، يمكنك متابعة الدرس التالي.":"لم يُسجّل الإكمال. تحقق من ترتيب الدروس أو حاول مرة أخرى.";if(activeStage is Guid sid)lessons=await Learning.LessonsAsync(userId,sid);}catch(Exception ex){Logger.LogError(ex,"Lesson completion failed {LessonId}",id);message="تعذر إكمال الدرس حاليًا";}finally{completingLesson=false;}}
 void Choose(Guid q,Guid o)=>answers[q]=o;
 void ChooseFinal(Guid q,Guid o)=>finalAnswers[q]=o;
 async Task SubmitStage(){
   if(activeStage is not Guid sid)return;
   var result=await Learning.SubmitAsync(userId,CourseId,sid,answers);
   message=$"{result.Message} — {result.Score}%";await Refresh();
 }
 async Task LoadFinal(){
   if(stages.Count==0 || stages.Any(s=>!s.Passed)){message="أكمل جميع المراحل أولًا";return;}
   var qs=await Learning.QuestionsAsync(userId,CourseId,null);
   if(qs.Count!=20){message="الامتحان النهائي غير مكتمل (يلزم 20 سؤالًا)";return;}
   finalQuestions=qs;finalAnswers.Clear();message=null;
 }
 async Task SubmitFinal(){
   var result=await Learning.SubmitAsync(userId,CourseId,null,finalAnswers);
   message=$"{result.Message} — {result.Score}%";await Refresh();
 }
 static bool IsYoutubeId(string? id)=>id is {Length:11} && id.All(c=>char.IsAsciiLetterOrDigit(c)||c=='_'||c=='-');
 static bool IsSafeHostedUrl(string? url)=>Uri.TryCreate(url,UriKind.Absolute,out var uri)&&uri.Scheme==Uri.UriSchemeHttps;
}
