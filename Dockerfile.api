FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /source
COPY src/AlManassa.Api/AlManassa.Api.csproj src/AlManassa.Api/
RUN dotnet restore src/AlManassa.Api/AlManassa.Api.csproj
COPY src/AlManassa.Api/ src/AlManassa.Api/
RUN dotnet publish src/AlManassa.Api/AlManassa.Api.csproj -c Release -o /app/publish --no-restore
FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /app/publish .
ENV ASPNETCORE_URLS=http://0.0.0.0:10000
EXPOSE 10000
ENTRYPOINT ["dotnet", "AlManassa.Api.dll"]
